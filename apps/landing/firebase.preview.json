{
  "hosting": {
    "site": "embody-future-of-work",
    "public": "dist",
    "ignore": ["firebase.preview.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
