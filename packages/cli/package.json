{
  "name": "@embody/cli",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "embody": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@embody/auth": "workspace:*",
    "@embody/core": "workspace:*",
    "@embody/host": "workspace:*",
    "@embody/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.0.18"
  }
}
