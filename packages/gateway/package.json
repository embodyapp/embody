{
  "name": "@embody/gateway",
  "version": "0.0.0",
  "description": "Gateway, app registry, authorization, and dispatch control plane for Embody.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimrod4278/embody.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/nimrod4278/embody#readme",
  "bugs": "https://github.com/nimrod4278/embody/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embody/core": "workspace:*",
    "@embody/host": "workspace:*",
    "@embody/mcp": "workspace:*",
    "fastify": "^5.12.1",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
