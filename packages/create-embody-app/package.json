{
  "name": "create-embody-app",
  "version": "0.1.0",
  "description": "Create a ready-to-run Embody TypeScript application.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimrod4278/embody.git",
    "directory": "packages/create-embody-app"
  },
  "homepage": "https://github.com/nimrod4278/embody#readme",
  "bugs": "https://github.com/nimrod4278/embody/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "bin": {
    "create-embody-app": "./bin/create-embody-app.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.0.18"
  }
}
