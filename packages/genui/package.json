{
  "name": "@embody/genui",
  "version": "0.0.0",
  "description": "Generative UI presentation contracts for agent-ready Embody applications.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embodyapp/embody.git",
    "directory": "packages/genui"
  },
  "homepage": "https://github.com/embodyapp/embody#readme",
  "bugs": "https://github.com/embodyapp/embody/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./app-runtime": {
      "types": "./dist/app-runtime.d.ts",
      "import": "./dist/app-runtime.js"
    },
    "./apps": {
      "types": "./dist/apps.d.ts",
      "import": "./dist/apps.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/standard-renderer.js"
    },
    "./renderer-global.js": "./dist/standard-renderer-global.js",
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-renderer.mjs",
    "test:browser": "pnpm build && vitest run --config vitest.browser.config.ts",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embody/core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "string-width": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "@types/node": "^22.20.1"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
