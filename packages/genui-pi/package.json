{
  "name": "@embody/genui-pi",
  "version": "0.0.0",
  "description": "Experimental Pi host integration primitives for Embody GenUI.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embodyapp/embody.git",
    "directory": "packages/genui-pi"
  },
  "homepage": "https://github.com/embodyapp/embody#readme",
  "bugs": {
    "url": "https://github.com/embodyapp/embody/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embody/genui": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22.20.1"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
