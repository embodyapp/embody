{
  "name": "@embody/core",
  "version": "0.1.0",
  "description": "Typed microkernel and plugin framework for agent-ready Embody applications.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimrod4278/embody.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nimrod4278/embody#readme",
  "bugs": "https://github.com/nimrod4278/embody/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "api-report": "api-extractor run --local --verbose",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.11"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
