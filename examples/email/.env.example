# Development defaults to SQLite and an intentionally unavailable mailer.
NODE_ENV=development
PORT=8082
DATABASE_FILE=.embody/email.sqlite

# Set only for an isolated test environment; this is not a real provider.
# MAILER_RECORD_FILE=.embody/mail/messages.json

# Production requires all values below plus an explicitly integrated Mailer provider.
# NODE_ENV=production
# DATABASE_URL=postgres://email:password@postgres:5432/email
# GATEWAY_URL=https://gateway.example.net
# PUBLIC_URL=https://email.example.net
# GATEWAY_REGISTRATION_SECRET=replace-with-a-per-app-secret
# GATEWAY_JWT_ISSUER=https://gateway.example.net
# GATEWAY_JWT_SECRET=replace-with-at-least-32-bytes
# EMBODY_EVENT_SECRET=replace-with-a-rotated-event-secret
