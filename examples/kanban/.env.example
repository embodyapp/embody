# Development uses embody.config.ts and SQLite with no credentials.
NODE_ENV=development
PORT=8081
DATABASE_FILE=.embody/kanban.sqlite

# Production requires all values below. Never commit real secrets.
# NODE_ENV=production
# DATABASE_URL=postgres://kanban:password@postgres:5432/kanban
# GATEWAY_URL=https://gateway.example.net
# PUBLIC_URL=https://kanban.example.net
# GATEWAY_REGISTRATION_SECRET=replace-with-a-per-app-secret
# GATEWAY_JWT_ISSUER=https://gateway.example.net
# GATEWAY_JWT_SECRET=replace-with-at-least-32-bytes
# EMBODY_EVENT_SECRET=replace-with-a-rotated-event-secret
# EMBODY_EVENT_DESTINATIONS={"kanban.card.ready_for_review":[{"appId":"email","endpoint":"https://email.example.net"}]
