    "@embody/testing": "workspace:*",
    "@embody/auth": "workspace:*",
    "@embody/gateway": "workspace:*",
    "playwright": "1.58.2",
    "esbuild": "0.28.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.20.1"
  }
