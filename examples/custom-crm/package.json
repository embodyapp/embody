{
  "name": "custom-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "embody-host ./embody.config.ts",
    "dev": "PORT=${PORT:-3100} embody-host ./embody.config.ts",
    "migrate": "embody-host ./embody.config.ts --mode migrate-only",
    "agent": "embody mcp",
    "seed": "embody seed"
  },
  "dependencies": {
    "@embody/cli": "workspace:*",
    "@embody/crm": "workspace:*",
    "@embody/host": "workspace:*",
    "@embody/plugin-sdk": "workspace:*",
    "embody-plugin-b2b-saas": "workspace:*",
    "embody-plugin-ecom-fulfillment": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@embody/testing": "workspace:*"
  }
}
