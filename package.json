{
  "name": "embody",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean && rm -rf coverage",
    "gateway:dev": "node scripts/gateway-dev.mjs up",
    "gateway:dev:down": "node scripts/gateway-dev.mjs down",
    "gateway:dev:logs": "node scripts/gateway-dev.mjs logs",
    "gateway:dev:help": "node scripts/gateway-dev.mjs help",
    "deploy:landing": "pnpm --filter @app/landing build && npx firebase-tools deploy --project nimrod-experiments --only hosting:embody",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "pnpm -r --filter './packages/**' --if-present build",
    "lint": "eslint . && node scripts/check-package-boundaries.mjs && pnpm skill:check",
    "skill:check": "node scripts/check-embody-skill.mjs",
    "license:check": "node scripts/check-license-readiness.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:production": "pnpm audit --prod --audit-level low",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:artifacts": "pnpm build && node scripts/check-release-artifacts.mjs",
    "api-report": "pnpm --filter @embody/core api-report",
    "test": "pnpm build && pnpm -r --if-present test",
    "test:consumer": "pnpm build && node scripts/test-packed-consumer.mjs",
    "test:genui-consumer": "node scripts/test-genui-packed-consumer.mjs",
    "test:genui-performance": "pnpm build && node --expose-gc scripts/measure-genui.mjs",
    "test:genui-postgres": "pnpm build && node scripts/verify-genui-postgres.mjs",
    "test:genui-terminal": "pnpm --filter @embody/genui-pi... build && node scripts/smoke-genui-terminal.mjs",
    "test:genui-journey": "pnpm build && P14_BROWSER=1 pnpm --filter @embody/example-kanban exec vitest run test/interactive-hosts.test.ts",
    "test:genui-release": "pnpm test && pnpm typecheck && pnpm lint && pnpm api-report && pnpm --filter @embody/genui test:browser && pnpm test:genui-journey && pnpm test:genui-consumer --browser && pnpm test:genui-terminal && pnpm test:genui-performance && pnpm test:genui-postgres && pnpm security:audit:production && pnpm license:check && pnpm release:artifacts",
    "test:postgres": "pnpm build && pnpm -r --if-present test:postgres",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm lint && pnpm license:check && pnpm typecheck && pnpm test && pnpm build && pnpm api-report && pnpm format:check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@microsoft/api-extractor": "^7.59.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  }
}
