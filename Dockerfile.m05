FROM gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.26.0 AS proxy
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile --reporter=append-only && pnpm build
FROM node:22-bookworm-slim
WORKDIR /workspace
COPY --chown=node:node --from=build /workspace /workspace
COPY --from=proxy /cloud-sql-proxy /usr/local/bin/cloud-sql-proxy
# Go's SQL proxy uses OS roots; node:slim does not include the trust bundle.
COPY --from=proxy /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG EMBODY_SOURCE_SHA
ENV EMBODY_SOURCE_SHA=$EMBODY_SOURCE_SHA
LABEL org.opencontainers.image.revision=$EMBODY_SOURCE_SHA
USER node
ENTRYPOINT ["node", "infra/mvp/fixture/entry.mjs"]
